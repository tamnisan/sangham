{
  "name": "sangam",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "merchant": "npm --workspace @sangam/merchant-api start",
    "shops": "npm --workspace @sangam/shops start",
    "settlement": "npm --workspace @sangam/settlement-agent start",
    "settlement:sim": "npm --workspace @sangam/settlement-agent run start:sim",
    "buy": "npm --workspace @sangam/customer-agent start --",
    "dashboard": "npm --workspace @sangam/dashboard run dev",
    "gen-keys": "tsx scripts/gen-keys.ts",
    "setup-hedera": "tsx scripts/setup-hedera.ts",
    "create-topic": "tsx scripts/create-hcs-topic.ts",
    "setup-0g": "tsx scripts/setup-0g.ts",
    "register-merchant": "tsx scripts/register-merchant.ts",
    "simulate": "tsx scripts/simulate-settlement.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.90.1",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  }
}
