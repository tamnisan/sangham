# Copy to .env and fill in. Never commit .env.
#
# [YOU]    you create this value (account, key, API key)
# [SCRIPT] a setup script prints it; paste it in
# [OK]     default works, change only if needed

# ── Dev switches ────────────────────────────────────────────────
# Each mock shows a badge on the dashboard. Turn them all off for the real demo.
ENS_OFFLINE=true            # true: read merchants from data/merchants.local.json instead of ENS
MERCHANTS_FILE=data/merchants.local.json  # data/merchants.render.json to buy from the deployed shops
OG_MOCK=true                # true: rule-based decision instead of 0G Compute
SKIP_CHAIN_VERIFY=false     # true: trust settlement notices without the Mirror Node check (only for npm run simulate)
PSP_MODE=mock               # mock | razorpayx
DEMO_STEP_DELAY_MS=800      # pause between settlement steps so the dashboard can show each one; 0 for real use

# ── Shared ──────────────────────────────────────────────────────
MERCHANT_ENS_NAME=tickets.sangam.eth          # [YOU] the ENS name you create; must match data/merchants.local.json while ENS_OFFLINE=true
SETTLEMENT_SHARED_SECRET=change-me            # [YOU] any random string: openssl rand -hex 32
SETTLEMENT_AGENT_URL=http://localhost:3001    # [OK] where merchant-api sends settlement notices
MERCHANT_API_PORT=3000                        # [OK]
SETTLEMENT_AGENT_PORT=3001                    # [OK]
DASHBOARD_ORIGIN=*                            # [OK] CORS origin for the dashboard; set to its URL once deployed
FX_API_URL=https://open.er-api.com/v6/latest/USD  # [OK] free USD→INR rate
FX_FALLBACK_INR_PER_USD=88                    # [OK] used if the rate API is down

# ── Test shops (npm run shops) ──────────────────────────────────
SHOPS_PORT=3002                               # [OK]
SHOPS_ENS_PARENT=sangam.eth                   # [YOU] once live: the ENS name you own; the shops become rail.<it>, news.<it>, …

# ── Agent sign-up (for sangam-mcp users) ────────────────────────
SIGNUP_ENABLED=false                          # true: POST /signup on the settlement agent opens testnet accounts, paid for by the operator
SIGNUP_STARTER_USDC=1                         # [OK] test USDC each new account gets from the operator

# ── Hedera testnet (portal.hedera.com → create ECDSA accounts) ──
HEDERA_USDC_TOKEN_ID=0.0.429274               # [OK] testnet USDC (HEDERA_TESTNET_USDC in @x402/hedera)
FACILITATOR_URL=https://api.testnet.blocky402.com  # [OK] backups: https://x402.org/facilitator, https://testnet.facilitator.ax402.io
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com  # [OK]

# Buyer agent: holds USDC and pays merchants.
CUSTOMER_ACCOUNT_ID=                          # [YOU] 0.0.x
CUSTOMER_PRIVATE_KEY=                         # [YOU] ECDSA hex key
CUSTOMER_BUDGET_USDC=2                        # [OK] the agent stops buying past this per run
CUSTOMER_MAX_PER_PAYMENT=$1                   # [OK] SDK hard cap per payment

# Sangam treasury: receives USDC (it's the merchant's sangam.payTo).
# Its key is only used by npm run setup-hedera to associate USDC.
TREASURY_ACCOUNT_ID=                          # [YOU] 0.0.x
TREASURY_PRIVATE_KEY=                         # [YOU]

# Operator: pays for HCS receipts. Can be the same account as the treasury.
OPERATOR_ACCOUNT_ID=                          # [YOU] 0.0.x
OPERATOR_PRIVATE_KEY=                         # [YOU]
HCS_TOPIC_ID=                                 # [SCRIPT] npm run create-topic

# ── 0G testnet (faucet.0g.ai) ───────────────────────────────────
OG_RPC_URL=https://evmrpc-testnet.0g.ai       # [OK] chain 16602
OG_PRIVATE_KEY=                               # [YOU] EVM key (0x…); can be the same key as ENS_OWNER_PRIVATE_KEY
OG_PROVIDER_ADDRESS=                          # [SCRIPT] pick one from: npm run setup-0g
OG_LEDGER_DEPOSIT=1                           # [OK] OG to put in the ledger (contract minimum 0.1)
OG_PROVIDER_FUND=0.5                          # [OK] OG moved to the provider (contract minimum 0.01)

# ── ENS (Sepolia, ENSv2) ────────────────────────────────────────
SEPOLIA_RPC_URL=                              # [OK] blank = viem's public Sepolia RPC; an Alchemy/Infura URL is more reliable
ENS_OWNER_PRIVATE_KEY=                        # [YOU] EVM key that owns the merchant's ENS name

# ── RazorpayX test mode (only when PSP_MODE=razorpayx) ──────────
PSP_KEY_ID=                                   # [YOU] rzp_test_…
PSP_KEY_SECRET=                               # [YOU]
RAZORPAYX_ACCOUNT_NUMBER=                     # [YOU] RazorpayX test account number

# ── Dashboard ───────────────────────────────────────────────────
VITE_SETTLEMENT_URL=                          # [OK] blank locally (dev proxy); set to the deployed settlement-agent URL
VITE_MERCHANT_URL=                            # [OK] blank locally (dev proxy); set to the deployed merchant-api URL
